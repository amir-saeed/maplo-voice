# Copy to .env and fill in. NEVER commit .env (it is git- and docker-ignored).
# Nested settings use "__", e.g. OPENAI__API_KEY maps to settings.openai.api_key.

# --------------------------------------------------------------------- app
ENVIRONMENT=local                 # local | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                    # true in containers / production
CORS_ORIGINS=["http://localhost:8000"]

# --------------------------------------------------------------------- OpenAI
OPENAI__API_KEY=sk-REPLACE_ME
# Optional overrides (defaults shown)
# OPENAI__LLM_MODEL=gpt-6-luna
# OPENAI__ASSESSMENT_MODEL=gpt-6.1-sol
# OPENAI__ASR_MODEL=gpt-transcribe
# OPENAI__ASR_FALLBACK_MODEL=gpt-4o-mini-transcribe
# OPENAI__TTS_MODEL=gpt-4o-mini-tts
# OPENAI__TTS_VOICE=marin
# OPENAI__EMBEDDING_MODEL=text-embedding-3-small

# --------------------------------------------------------------------- auth
# JSON list of bearer tokens. Empty list = open access (only allowed in local/test).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH__API_TOKENS=[]

# --------------------------------------------------------------------- database
# Used by docker compose to initialise Postgres and to build DATABASE__URL.
POSTGRES_USER=maplo
POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_PASSWORD
POSTGRES_DB=maplo_voice
# When running the app outside Docker:
# DATABASE__URL=postgresql+asyncpg://maplo:<password>@localhost:5432/maplo_voice

# --------------------------------------------------------------------- voice / privacy
VOICE__STORE_TRANSCRIPTS=true     # false = persist metrics only, never what was said
# VOICE__VAD_SILENCE_MS=700
# VOICE__MAX_CONCURRENT_SESSIONS=200

# --------------------------------------------------------------------- telemetry
TELEMETRY__ENABLED=true
# TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
# TELEMETRY__TRACE_SAMPLE_RATIO=1.0

# --------------------------------------------------------------------- grafana (local stack)
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LOCAL_PASSWORD
